{"fn":"truncateHead","note":"one over maxBytes on a single line -> firstLineExceedsLimit","input":"abcd","options":{"maxBytes":3},"result":{"content":"","truncated":true,"truncatedBy":"bytes","totalLines":1,"totalBytes":4,"outputLines":0,"outputBytes":0,"lastLinePartial":false,"firstLineExceedsLimit":true,"maxLines":2000,"maxBytes":3}}
{"fn":"truncateHead","note":"first line exceeds byte limit, more lines follow","input":"abcdef\nshort\n","options":{"maxBytes":3},"result":{"content":"","truncated":true,"truncatedBy":"bytes","totalLines":2,"totalBytes":13,"outputLines":0,"outputBytes":0,"lastLinePartial":false,"firstLineExceedsLimit":true,"maxLines":2000,"maxBytes":3}}
{"fn":"truncateHead","note":"byte limit hit mid-file, newline counted for every line after the first","input":"aa\nbb\ncc\n","options":{"maxBytes":5},"result":{"content":"aa\nbb","truncated":true,"truncatedBy":"bytes","totalLines":3,"totalBytes":9,"outputLines":2,"outputBytes":5,"lastLinePartial":false,"firstLineExceedsLimit":false,"maxLines":2000,"maxBytes":5}}
{"fn":"truncateHead","note":"newline charge on line 2 decides the cut: 'bb' costs 2+1=3, so 2+3 > 4 and only 'aa' fits (charging the newline from line 3 onwards would wrongly keep 'bb')","input":"aa\nbb\ncc\n","options":{"maxBytes":4},"result":{"content":"aa","truncated":true,"truncatedBy":"bytes","totalLines":3,"totalBytes":9,"outputLines":1,"outputBytes":2,"lastLinePartial":false,"firstLineExceedsLimit":false,"maxLines":2000,"maxBytes":4}}
{"fn":"truncateHead","note":"maxBytes=6 does NOT pin the newline charge: 'aa\\nbb' fits either way (2+3=5 vs 2+2=4) and 'cc' overflows either way (5+3=8 vs 4+3=7), so the 4- and 7-byte cases above/below are the ones that do","input":"aa\nbb\ncc\n","options":{"maxBytes":6},"result":{"content":"aa\nbb","truncated":true,"truncatedBy":"bytes","totalLines":3,"totalBytes":9,"outputLines":2,"outputBytes":5,"lastLinePartial":false,"firstLineExceedsLimit":false,"maxLines":2000,"maxBytes":6}}
{"fn":"truncateHead","note":"running total decides at line 3: 5+3 > 7 cuts after 'bb' with truncatedBy='bytes'; one byte less of accumulated newline charge would admit 'cc' and leave truncatedBy='lines'","input":"aa\nbb\ncc\n","options":{"maxBytes":7},"result":{"content":"aa\nbb","truncated":true,"truncatedBy":"bytes","totalLines":3,"totalBytes":9,"outputLines":2,"outputBytes":5,"lastLinePartial":false,"firstLineExceedsLimit":false,"maxLines":2000,"maxBytes":7}}
{"fn":"truncateHead","note":"QUIRK: totalBytes(9) > maxBytes(8) so truncated=true, but every line fits in 8 bytes once the trailing newline is dropped, so the loop never sets truncatedBy='bytes' and the initial value 'lines' survives even though maxLines was never reached","input":"aa\nbb\ncc\n","options":{"maxBytes":8},"result":{"content":"aa\nbb\ncc","truncated":true,"truncatedBy":"lines","totalLines":3,"totalBytes":9,"outputLines":3,"outputBytes":8,"lastLinePartial":false,"firstLineExceedsLimit":false,"maxLines":2000,"maxBytes":8}}
{"fn":"truncateHead","note":"both limits exceeded, lines wins first","input":"aa\nbb\ncc\ndd\n","options":{"maxLines":2,"maxBytes":1000},"result":{"content":"aa\nbb","truncated":true,"truncatedBy":"lines","totalLines":4,"totalBytes":12,"outputLines":2,"outputBytes":5,"lastLinePartial":false,"firstLineExceedsLimit":false,"maxLines":2,"maxBytes":1000}}
{"fn":"truncateHead","note":"both limits exceeded, bytes wins first","input":"aa\nbb\ncc\ndd\n","options":{"maxLines":100,"maxBytes":5},"result":{"content":"aa\nbb","truncated":true,"truncatedBy":"bytes","totalLines":4,"totalBytes":12,"outputLines":2,"outputBytes":5,"lastLinePartial":false,"firstLineExceedsLimit":false,"maxLines":100,"maxBytes":5}}
