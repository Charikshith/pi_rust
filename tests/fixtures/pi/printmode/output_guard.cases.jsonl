{"name":"takeover-redirects-console-log-to-stderr","note":"THE central hazard: after takeOverStdout(), process.stdout.write is replaced by a function that calls rawStderrWrite, so console.log lands on STDERR while writeRawStdout still reaches real STDOUT","steps":["log:BEFORE-STDOUT","takeover","log:AFTER-GOES-TO-STDERR","raw:RAW-STILL-STDOUT","error:EXPLICIT-STDERR","flush"],"stdout":"BEFORE-STDOUT\nRAW-STILL-STDOUT\n","stderr":"AFTER-GOES-TO-STDERR\nEXPLICIT-STDERR\n","stdoutMarkers":["BEFORE-STDOUT","RAW-STILL-STDOUT"],"stderrMarkers":["AFTER-GOES-TO-STDERR","EXPLICIT-STDERR"],"landedOn":{"BEFORE-STDOUT":"stdout","RAW-STILL-STDOUT":"stdout","AFTER-GOES-TO-STDERR":"stderr","EXPLICIT-STDERR":"stderr"},"observations":[{"step":"log:BEFORE-STDOUT","via":"console.log"},{"step":"takeover","isStdoutTakenOver":true},{"step":"log:AFTER-GOES-TO-STDERR","via":"console.log"},{"step":"raw:RAW-STILL-STDOUT","via":"writeRawStdout"},{"step":"error:EXPLICIT-STDERR","via":"console.error"},{"step":"flush","via":"flushRawStdout"}],"exitCode":0}
